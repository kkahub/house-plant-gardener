rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function notExpired() {
      return request.time < timestamp.date(2026, 11, 30);
    }

    function signedIn() {
      return request.auth != null;
    }

    // ID : `${uid}_${plantId}`
    function ownsId(docId) {
      return signedIn() && docId.matches(request.auth.uid + '_.*');
    }

    // 조회수 조작 방지
    function validCountStep() {
      let before = resource == null ? {} : resource.data;
      let after = request.resource.data;
      let keys = after.diff(before).affectedKeys();
      return keys.size() == 1
        && keys.hasOnly(['readCount', 'likeCount', 'bookmarkCount'])
        && stepOk(keys, before, after, 'readCount', [1])
        && stepOk(keys, before, after, 'likeCount', [1, -1])
        && stepOk(keys, before, after, 'bookmarkCount', [1, -1]);
    }

    function stepOk(keys, before, after, key, allowed) {
      return !(key in keys)
        || ((after.get(key, 0) - before.get(key, 0)) in allowed && after.get(key, 0) >= 0);
    }

    // 상세페이지 조회수·좋아요·북마크 유저 조건
    match /plantId/{docId} {
      allow read: if notExpired();
      allow create, update: if notExpired() && signedIn() && validCountStep();
    }

    match /plantCode/{docId} {
      allow read: if notExpired();
      allow create, update: if notExpired() && signedIn() && validCountStep();
    }

    // 좋아요·북마크·노트 유저 조건
    match /{col}/{docId} {
      allow get: if notExpired() && isPersonal(col) && ownsId(docId);
      allow list: if notExpired() && isPersonal(col) && signedIn()
        && resource.data.uid == request.auth.uid;
      allow create, update: if notExpired() && isPersonal(col) && ownsId(docId)
        && request.resource.data.uid == request.auth.uid;
      allow delete: if notExpired() && isPersonal(col) && ownsId(docId);
    }

    function isPersonal(col) {
      return col in ['guide_likes', 'guide_bookmarks', 'guide_notes',
                     'indoor_likes', 'indoor_bookmarks', 'indoor_notes'];
    }
  }
}
